{
  "uid": "aicd-overview",
  "title": "AiCodingDev — метрики ТЗ §16",
  "description": "Run success rate, verified completion, gates, approvals, провайдеры CLI, Code Intelligence (P8-08).",
  "tags": [
    "aicodingdev",
    "tz-16"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Runs и задачи (ТЗ §16)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Run success rate (24 ч)",
      "description": "Доля COMPLETED среди завершённых run за 24 ч (по outbox run.completed).",
      "datasource": {
        "type": "prometheus",
        "uid": "aicd-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aicd-prometheus"
          },
          "expr": "sum(increase(aicd_runs_finished_total{final_status=\"COMPLETED\"}[24h])) / sum(increase(aicd_runs_finished_total[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Verified completion (24 ч)",
      "description": "Доля задач, дошедших до SUCCEEDED (только после PASS обязательных gates), среди завершившихся SUCCEEDED/FAILED.",
      "datasource": {
        "type": "prometheus",
        "uid": "aicd-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aicd-prometheus"
          },
          "expr": "sum(increase(aicd_task_transitions_total{to_status=\"SUCCEEDED\"}[24h])) / sum(increase(aicd_task_transitions_total{to_status=~\"SUCCEEDED|FAILED\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Завершённые run по статусу",
      "description": "Число завершённых run за час по итоговому статусу.",
      "datasource": {
        "type": "prometheus",
        "uid": "aicd-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aicd-prometheus"
          },
          "expr": "sum by (final_status) (increase(aicd_runs_finished_total[1h]))",
          "refId": "A",
          "legendFormat": "{{final_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Переходы задач (повторы, блокировки)",
      "description": "Переходов в минуту; RETRY_WAIT — retry count.",
      "datasource": {
        "type": "prometheus",
        "uid": "aicd-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aicd-prometheus"
          },
          "expr": "sum by (to_status) (rate(aicd_task_transitions_total{to_status=~\"RETRY_WAIT|BLOCKED|FAILED|SUCCEEDED\"}[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{to_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
