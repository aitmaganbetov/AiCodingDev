        {
          "datasource": {
            "type": "prometheus",
            "uid": "aicd-prometheus"
          },
          "expr": "sum(increase(aicd_outbox_publish_failures_total[5m]))",
          "refId": "B",
          "legendFormat": "ошибки за 5 мин"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
