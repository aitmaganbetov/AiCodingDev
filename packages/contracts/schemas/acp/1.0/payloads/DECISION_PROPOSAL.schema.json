{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicodingdev.local/contracts/acp/1.0/payloads/DECISION_PROPOSAL.schema.json",
  "title": "DECISION_PROPOSAL payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_type",
    "title",
    "options",
    "recommended_option",
    "rationale",
    "requires_human_approval"
  ],
  "properties": {
    "decision_type": {
      "enum": [
        "architecture",
        "technology_choice",
        "scope_change",
        "plan_change",
        "risk_acceptance",
        "data_model",
        "api_contract",
        "other"
      ]
    },
    "title": {
      "$ref": "../common.schema.json#/$defs/text_short"
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "summary"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,40}$"
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "pros": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "cons": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      }
    },
    "recommended_option": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,40}$"
    },
    "rationale": {
      "$ref": "../common.schema.json#/$defs/text_long"
    },
    "evidence_refs": {
      "$ref": "../common.schema.json#/$defs/refs"
    },
    "requires_human_approval": {
      "type": "boolean",
      "description": "Orchestrator может только повысить до true по policy"
    },
    "adr_draft_ref": {
      "$ref": "../common.schema.json#/$defs/ref"
    }
  }
}
