{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicodingdev.local/contracts/acp/1.0/payloads/FIX_REQUEST.schema.json",
  "title": "FIX_REQUEST payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding",
    "severity",
    "file",
    "evidence_refs",
    "requested_action",
    "loop_iteration"
  ],
  "properties": {
    "finding": {
      "$ref": "../common.schema.json#/$defs/text_short"
    },
    "severity": {
      "$ref": "../common.schema.json#/$defs/severity"
    },
    "file": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/file_path"
        },
        {
          "type": "null"
        }
      ]
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "../common.schema.json#/$defs/ref"
      }
    },
    "requested_action": {
      "$ref": "../common.schema.json#/$defs/text_long"
    },
    "finding_refs": {
      "$ref": "../common.schema.json#/$defs/refs"
    },
    "loop_iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "regression_test_required": {
      "type": "boolean"
    }
  }
}
