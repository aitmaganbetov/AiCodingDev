{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicodingdev.local/contracts/acp/1.0/payloads/TASK_ASSIGN.schema.json",
  "title": "TASK_ASSIGN payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "attempt_no",
    "title",
    "objective",
    "acceptance_criteria",
    "complexity",
    "risk_level",
    "provider",
    "context_pack_ref",
    "instruction_template_version",
    "permissions"
  ],
  "properties": {
    "task_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "title": {
      "$ref": "../common.schema.json#/$defs/text_short"
    },
    "objective": {
      "$ref": "../common.schema.json#/$defs/text_long"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "complexity": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "provider": {
      "$ref": "../common.schema.json#/$defs/provider"
    },
    "routing_decision_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "context_pack_ref": {
      "$ref": "../common.schema.json#/$defs/ref"
    },
    "instruction_template_version": {
      "type": "string",
      "pattern": "^[a-z_]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "input_refs": {
      "$ref": "../common.schema.json#/$defs/refs"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "write_scope",
        "network"
      ],
      "properties": {
        "write_scope": {
          "enum": [
            "none",
            "worktree"
          ]
        },
        "network": {
          "enum": [
            "none",
            "restricted",
            "unrestricted"
          ]
        }
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 14400
    },
    "review_independence": {
      "enum": [
        "independent",
        "self_review_fallback",
        "not_required"
      ],
      "description": "только для reviewer/security; см. ROUTING_POLICY"
    }
  }
}
