{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicodingdev.local/contracts/events/1.0/outbox-envelope.schema.json",
  "title": "OutboxEventEnvelope",
  "description": "Тело Dramatiq-сообщения outbox-dispatcher (OutboxRecord.message(), aicd_platform.sse): строка outbox_events + traceparent. Потребители перечитывают состояние из PostgreSQL; payload — данные события (каталог EVENT_SCHEMAS §2.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "workspace_id",
    "run_id",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "payload",
    "traceparent"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "= outbox_events.id (UUIDv7)"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "= outbox_events.event_type (CHECK миграции 0003)"
    },
    "schema_version": {
      "const": "1.0"
    },
    "aggregate_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "= outbox_events.aggregate_type (run, task, agent_message, chat_message, directive, approval, gate_execution, external_action, cli_provider, documentation_source, github_verification, worktree, …)"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "null только для глобальных агрегатов"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "outbox_events.created_at, UTC с Z"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "по умолчанию run_id"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "event_id/команда, вызвавшая это событие"
    },
    "payload": {
      "type": "object",
      "description": "данные события (outbox_events.payload, редактированы, ≤ 64 KiB)"
    },
    "traceparent": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
      "description": "W3C trace context спана публикации (P8-06); потребитель продолжает трассу"
    }
  }
}
