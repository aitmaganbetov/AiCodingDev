{
  "name": "@aicd/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "size": "node scripts/bundle-size.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e": "playwright test -c playwright.mocked.config.ts --trace off",
    "e2e:live": "playwright test -c playwright.live.config.ts --trace off",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/gen-api.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "@xyflow/react": "12.12.0",
    "cmdk": "1.1.1",
    "i18next": "26.5.7",
    "lucide-react": "1.61.0",
    "monaco-editor": "0.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.1.5",
    "react-resizable-panels": "4.15.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
